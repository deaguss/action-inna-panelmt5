{
  "manifest_version": 3,
  "name": "ActionInna",
  "version": "0.1.0",
  "description": "Risk-sized MetaTrader 5 orders in a side panel next to TradingView, sent through your own MT5.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "nativeMessaging", "storage"],
  "optional_host_permissions": ["https://www.tradingview.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open ActionInna",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
