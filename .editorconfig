root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{mq5,mqh}]
indent_style = space
indent_size = 3
end_of_line = crlf

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.bat]
end_of_line = crlf

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
