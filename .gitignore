# Claude Code's own files: settings for this PC, and its preview entry for tests/extension/serve.js
.claude/settings.local.json
.claude/launch.json

# Editor files generated on this PC (MQL clangd extension, VS Code); they hold local paths
.vscode/
.clangd
.clang-format
compile_commands.json
.mql-auto-forwards/

# Native test build (tests/native/run.sh) and the link tests' files (tests/link/run.js)
tests/native/out/
tests/link/out/
