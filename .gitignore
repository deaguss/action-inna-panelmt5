# Compiled programs and MetaEditor logs
*.ex5
*.log

# Build output and the EA's runtime files (linked into MQL5\Files\ActionInna)
build/
runtime/
anti-slop/

# This PC's MT5 paths, written by scripts/link-mt5.ps1
