# Text files are stored with LF; MQL5 sources check out with CRLF, as MetaEditor writes them.
* text=auto
*.mq5 text eol=crlf
*.mqh text eol=crlf
*.ps1 text eol=crlf
# Shell scripts keep LF everywhere: Bash stops at a CR.
*.sh text eol=lf

# Compiled MQL5 programs, and the side panel's icons
*.ex5 binary
*.png binary
